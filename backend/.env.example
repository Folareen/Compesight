ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://compesight:compesight@localhost:5432/compesight

REDIS_URL=redis://localhost:6379/0

# Clerk — from your Clerk instance's API Keys page
CLERK_SECRET_KEY=
# JWKS URL: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Issuer: https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=

# Crawling — identify honestly, per docs/scraping.md. Never impersonate a browser.
CRAWLER_USER_AGENT=CompesightBot/1.0 (+https://compesight.example/bot)
CRAWL_TIMEOUT_MS=30000
CRAWL_MIN_HOST_INTERVAL_SECONDS=2.0
CRAWL_BACKOFF_BASE_SECONDS=5.0
CRAWL_BACKOFF_CAP_SECONDS=600.0
CRAWL_BACKOFF_JITTER_SECONDS=3.0
SCHEDULER_ENQUEUE_JITTER_SECONDS=60
SOURCE_LOCK_TTL_SECONDS=300
ROBOTS_CACHE_TTL_SECONDS=3600
EXTRACTION_DRIFT_THRESHOLD=3
SOURCE_DISCOVERY_TIMEOUT_SECONDS=5.0

# LLM — from your Anthropic Console API Keys page
ANTHROPIC_API_KEY=
LLM_CLASSIFICATION_MODEL=claude-haiku-4-5
LLM_EXTRACTION_FALLBACK_MODEL=claude-sonnet-5
LLM_MAX_INPUT_CHARS=8000
LLM_BUDGET_SOFT_WARN_RATIO=0.8

# Alerts — Resend for email, Slack via incoming webhook, generic webhook
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@compesight.example
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=
ALERT_DELIVERY_MAX_RETRIES=5
ALERT_BACKOFF_BASE_SECONDS=30.0
ALERT_BACKOFF_CAP_SECONDS=3600.0
ALERT_BACKOFF_JITTER_SECONDS=10.0
DASHBOARD_BASE_URL=http://localhost:3000
