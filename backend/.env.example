ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://compesight:compesight@localhost:5432/compesight

REDIS_URL=redis://localhost:6379/0

# Clerk — from your Clerk instance's API Keys page
CLERK_SECRET_KEY=
# JWKS URL: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Issuer: https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=
